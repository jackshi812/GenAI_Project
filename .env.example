# Obtain from https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Obtain from https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Obtain from https://serper.dev/.
SERPER_API_KEY=

LLM_PROVIDER=anthropic
# A cheaper compatible model may be used when API cost is a concern.
LLM_MODEL=claude-opus-5
# Applied to OpenAI reasoning models. Lower effort keeps short voice replies
# inside the interactive timeout; ignored by Anthropic models.
LLM_REASONING_EFFORT=low
# interactive keeps the required LangGraph stages and uses bounded, selective
# language calls instead of a sequential prompt chain. Set to llm for the
# prompt-heavy audit graph.
GRAPH_MODE=interactive
PREFERENCE_LLM=1
PREFERENCE_LLM_TIMEOUT_S=6.0
DECISION_LLM_TIMEOUT_S=6.0
DIALOGUE_LLM_TIMEOUT_S=6.0
DIALOGUE_LLM=1
NATURAL_RESPONSE_LLM=1
ANSWER_LLM_TIMEOUT_S=8.0
WHISPER_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Used only for the short response that starts before the full graph finishes.
FAST_TTS_MODEL=tts-1
# Leave all three LiveKit values blank for the local `livekit-server --dev`
# setup. Set all three together when using LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=product-discovery
LIVEKIT_STT_MODEL=gpt-realtime-whisper
# tts-1 is optimized for low-latency speech generation.
LIVEKIT_TTS_MODEL=tts-1
LIVEKIT_TTS_VOICE=alloy
VOICE_END_SILENCE_S=0.35
VOICE_TTFA_TARGET_MS=3000
CHROMA_PATH=catalog/chroma
WEB_SEARCH_CACHE_TTL=180
WEB_SEARCH_MIN_INTERVAL_S=1.0
WEB_SEARCH_MAX_CALLS=50
TOOL_MODE=live
