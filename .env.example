# Obtain from https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Obtain from https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Obtain from https://serper.dev/.
SERPER_API_KEY=

LLM_PROVIDER=anthropic
# A cheaper compatible model may be used when API cost is a concern.
LLM_MODEL=claude-opus-5
WHISPER_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
CHROMA_PATH=catalog/chroma
WEB_SEARCH_CACHE_TTL=180
WEB_SEARCH_MIN_INTERVAL_S=1.0
WEB_SEARCH_MAX_CALLS=50
TOOL_MODE=live
